{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug Server",
        "type": "node",
        "request": "launch",
        "killBehavior": "polite",
        "localRoot": "${workspaceFolder}",
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/nodemon",
        "args": ["src/server.ts"],
        "skipFiles": ["<node_internals>/**"],
        "sourceMaps": true,
        "restart": true,
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen"
      }
    ]
  }