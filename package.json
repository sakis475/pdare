    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "express-winston": "^4.2.0",
    "jsonwebtoken": "^9.0.0",
    "lodash": "^4.17.21",
    "morgan": "^1.10.0",
    "pg": "^8.11.0",
    "puppeteer": "^22.6.3",
    "react-native-dropdown-picker": "^5.4.6",
