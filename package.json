  "main": "index.js",
  "scripts": {
    "start": "nodemon --signal SIGTERM src/server.ts",
    "start-tsnode": "ts-node ./src/server.ts",
    "prod": "npm run build && node ./dist/src/server.js",
    "build": "npx tsc",
    "test": "npm run build && jest",
    "typeorm": "ts-node ./node_modules/typeorm/cli.js",
    "serveo": "ssh -R 80:localhost:8000 serveo.net",
    "localtunnel": "lt --port 8000",
    "ngrok": "ngrok http localhost:8000",
    "pinggy": "ssh -p 443 -R0:localhost:8000 qr@a.pinggy.io",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d ./src/database/connection.ts ./src/database/migrations/$npm_config_name",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d ./src/database/connection.ts"
  },
  "author": "",
